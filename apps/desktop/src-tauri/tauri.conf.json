{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stash",
  "version": "0.1.0",
  "identifier": "app.stashfm.desktop",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Stash",
    "shortDescription": "Stash, a music player for your own library",
    "longDescription": "Stash plays the music on your computer and the sources you add, gapless, with its quality shown as decoded.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/rawnaldclark/stash-desktop",
    "resources": {
      "../../../third_party/mpv/libmpv-2.dll": "libmpv-2.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
